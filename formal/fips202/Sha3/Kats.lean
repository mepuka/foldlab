import Sha3.Impl

/-!
# T7–T10: kernel known-answer theorems (Pass B frozen statements)

Digest literals are the pinned CAVP values (`SHA3_512ShortMsg.rsp`,
sha256 11d0676f4c6f10e30c5025204f4e15cd1ef6b1e34f6660d586d8ae9dfab4d721), mechanically converted
from the response-file hex. Each theorem carries its dregg-style literal statement pin.
Expected axiom profile throughout: `[propext, Quot.sound]`.
-/

set_option maxRecDepth 8000000
set_option maxHeartbeats 8000000

namespace Sha3.Kats

open Sha3.Impl

