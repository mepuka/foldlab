/-- T10: the domain-separation suffix is load-bearing — pre-FIPS Keccak padding produces a
different digest on the empty message. A transcription that dropped the `01` suffix could not
prove this. -/
theorem sha3_ne_prefips : keccak512_prefips [] ≠ sha3_512 [] := by decide

example : keccak512_prefips [] ≠ sha3_512 [] := sha3_ne_prefips

