import Cas
import Cas.Vectors.Vectors
import Cas.Vectors.Schema

/-!
# The registered grammar terms — one registry, two consumers

The concrete trees the conformance vectors are seeded from, factored
out of the vector tool so the backend's program emitter lowers the
SAME terms — vectors and generated programs cannot drift apart.
Content is generated by executing the model under `sha256Addr`, never
hand-typed.
-/

namespace Cas.Vectors.Registry

open Cas Cas.Grammar

/-! ## The registered content — grammar terms under `sha256Addr` -/

/-- One opaque value node, no references — the smallest word. -/
def helloValue : Tree .value := .value (Payload.utf8 "hello, cas")

/-- A two-leaf blob: chunks, leaves, parent, manifest — every blob
sort and a two-reference node. -/
def chunkA : Tree .chunk := .chunk (Payload.utf8 "0123456789abcdef")
def chunkB : Tree .chunk := .chunk (Payload.utf8 "ghijklmnopqrstuv")
def blobTwoLeaves : Tree .manifest :=
  .manifest 1 32 2 (.parent (.leaf 0 16 chunkA) (.leaf 1 16 chunkB))

/-- A named file over a one-chunk blob — the framed-pair payload. -/
def fileReadme : Tree .file := save% "readme.md" := "# the store word"

/-- A journal: genesis, then two entries over saved files — the
deepest reference chains and the empty-payload nodes. -/
def journalTwo : Tree .entry := journal% [
  save% "readme.md" := "# the store word",
  save% "notes.txt" := "children first, admission order"
]

/-- Two leaves over ONE shared chunk: `flatten` carries the chunk's
binding twice, so the word itself exhibits deduplication — the replay
must treat the second occurrence as a duplicate, not a conflict. -/
def sharedChunk : Tree .chunk := .chunk (Payload.utf8 "one chunk, twice")
def blobSharedChunk : Tree .tree :=
  .parent (.leaf 0 16 sharedChunk) (.leaf 1 16 sharedChunk)

/-- The vector format's own canonical schema - the code the schema
vector stores and the program emitter re-puts. -/
def vectorDocumentCode : Cas.Schema.Ast :=
  Cas.Schema.Described.code (α := Cas.Vectors.Wire.VectorDocument)

end Cas.Vectors.Registry
