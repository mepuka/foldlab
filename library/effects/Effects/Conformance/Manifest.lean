import Effects.Conformance.Json
import Effects.Conformance.ModelVersion
import Effects.Conformance.Instances.CAS001
import Effects.Conformance.Instances.CAS002

/-!
# The manifest generator — first vectors

Per-family JSON, generated by executing the Lean model (WGR-4): inputs are
the Lean fixtures below and the instance kits, expectations are computed by
running the model on them — outputs are never written by hand. The family
header's `meaning` projects the instance's ratified sentence; `model` is
the declared model version. Rows are sorted by case id and rendered through
the canonical printer.

Clause names in expectations carry the runtime error family's tags
(`CasError/DanglingReference`, `CasError/WrongKindReference`) with the
model clause's payload — the manifest is the inter-lane contract, and the
clause correspondence is part of it.
-/

namespace Effects.Conformance.Manifest

open Effects.Cas Json

/-! ## Value encodings -/

def bytesJson (b : Bytes) : Value := .arr (b.map fun x => .nat x.toNat)

def addrJson (a : Addr32) : Value := bytesJson a.val

def refJson (r : Ref) : Value :=
  .obj [("addr", addrJson r.addr), ("expectedTag", .nat r.expectedTag.toNat)]

def nodeJson (n : Node) : Value :=
  .obj [ ("payload", bytesJson n.payload)
       , ("refs", .arr (n.refs.map refJson))
       , ("tag", .nat n.tag.toNat)
       , ("version", .nat n.version.toNat) ]

def clauseJson : AdmissionError → List (String × Value)
  | .dangling missing =>
      [ ("clause", .str "CasError/DanglingReference")
      , ("missing", addrJson missing) ]
  | .wrongKind ref expected actual =>
      [ ("actualTag", .nat actual.toNat)
      , ("clause", .str "CasError/WrongKindReference")
      , ("expectedTag", .nat expected.toNat)
      , ("ref", addrJson ref) ]

/-! ## Manifest fixtures

The instance kits are the first inputs; `wrongKindNode` extends coverage to
the second admission clause — the sentence names both, so the manifest
carries both. -/

/-- A node whose one reference declares kind tag seven at the kit store's
bound address, where the resident carries kind tag five. -/
def wrongKindNode : Node := ⟨0, 1, [], [⟨7, cas002Bound⟩]⟩

/-- A second, distinct address for reference-ordering coverage:
thirty-two bytes of two. -/
def addrB : Addr32 := ⟨List.replicate 32 2, by simp⟩

/-- Declared vector growth (M4 Pass A, same version): a nontrivial
payload under the round trip. -/
def payloadNode : AdmittedNode := ⟨⟨0, 3, [1, 2, 3, 250, 255], []⟩, by decide⟩

/-- Declared vector growth: two ordered typed references and a nonempty
payload — payload framing, reference count, and per-reference bytes
exercised in one admitted node. -/
def multiRefNode : AdmittedNode :=
  ⟨⟨0, 3, [9], [⟨5, cas002Bound⟩, ⟨7, addrB⟩]⟩, by decide⟩

/-- Declared vector growth: a resolving reference beside a wrong-kind one
— admission must reject even when an earlier reference is fine. -/
def mixedRefsNode : Node := ⟨0, 1, [], [⟨5, cas002Bound⟩, ⟨7, cas002Bound⟩]⟩

/-- Declared vector growth: two references, both resolving at the
declared kind. -/
def twoResolvingNode : Node := ⟨0, 1, [], [⟨5, cas002Bound⟩, ⟨5, cas002Bound⟩]⟩

/-- The kit store's bindings, rendered as data for the manifest. -/
def storeBindings : List (Addr32 × Node) := [(cas002Bound, cas002Resident)]

def storeJson : Value :=
  .arr (storeBindings.map fun (a, m) =>
    .obj [("addr", addrJson a), ("node", nodeJson m)])

/-! ## CAS-001 rows — executed from the codec -/

def cas001RoundtripRowAt (caseId : String) (n : AdmittedNode) : Value :=
  let bytes := encodeAdmitted n
  let roundtrip := decide (decodeAdmitted bytes = some n)
  .obj [ ("case", .str caseId)
       , ("expect", .obj [("bytes", bytesJson bytes), ("roundtrip", .bool roundtrip)])
       , ("input", .obj [("node", nodeJson n.val)]) ]

def cas001RoundtripRow : Value :=
  cas001RoundtripRowAt "roundtrip-smallest-000" cas001PosNode

def cas001RejectRow : Value :=
  let decoded := match decodeAdmitted cas001NegBytes with
    | some n => nodeJson n.val
    | none => .null
  .obj [ ("case", .str "reject-trailing-byte-001")
       , ("expect", .obj [("decoded", decoded)])
       , ("input", .obj [("bytes", bytesJson cas001NegBytes)]) ]

/-! ## CAS-002 rows — executed from store admission -/

def admissionExpect (n : Node) : Value :=
  match admitNode cas002Store n with
  | .ok _ => .obj [("admitted", .bool true)]
  | .error e => .obj (("admitted", .bool false) :: clauseJson e)

def cas002Row (caseId : String) (n : Node) : Value :=
  .obj [ ("case", .str caseId)
       , ("expect", admissionExpect n)
       , ("input", .obj [("node", nodeJson n), ("store", storeJson)]) ]

/-! ## The family documents -/

def familyManifestAt (version family meaning : String)
    (rows : List (String × Value)) : Value :=
  .obj [ ("family", .str family)
       , ("meaning", .str meaning)
       , ("model", .str version)
       , ("rows", .arr ((rows.mergeSort fun a b => decide (a.1 ≤ b.1)).map (·.2))) ]

def familyManifest (family meaning : String) (rows : List (String × Value)) :
    Value :=
  familyManifestAt modelVersion family meaning rows

def cas001Rows : List (String × Value) :=
  [ ("roundtrip-smallest-000", cas001RoundtripRow)
  , ("reject-trailing-byte-001", cas001RejectRow)
  , ("roundtrip-payload-002",
      cas001RoundtripRowAt "roundtrip-payload-002" payloadNode)
  , ("roundtrip-multi-ref-003",
      cas001RoundtripRowAt "roundtrip-multi-ref-003" multiRefNode) ]

def cas002Rows : List (String × Value) :=
  [ ("admit-resolving-ref-000", cas002Row "admit-resolving-ref-000" cas002Pos)
  , ("reject-dangling-001", cas002Row "reject-dangling-001" cas002Neg)
  , ("reject-wrong-kind-002", cas002Row "reject-wrong-kind-002" wrongKindNode)
  , ("reject-wrong-kind-among-refs-003",
      cas002Row "reject-wrong-kind-among-refs-003" mixedRefsNode)
  , ("admit-two-resolving-refs-004",
      cas002Row "admit-two-resolving-refs-004" twoResolvingNode) ]

def cas001Manifest : Value := familyManifest "CAS-001" cas001.sentence cas001Rows

def cas002Manifest : Value := familyManifest "CAS-002" cas002.sentence cas002Rows

/-- The committed manifest files: name and rendered content. -/
def files : List (String × String) :=
  [ ("CAS-001.json", Json.document cas001Manifest)
  , ("CAS-002.json", Json.document cas002Manifest) ]

end Effects.Conformance.Manifest
