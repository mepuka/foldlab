{
  "name": "@foldlab/cas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A content-addressed store as a data structure — memory, file, or any static host below one seam; servable over cas-http/0",
  "license": "Apache-2.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PROFILE-CAS-HTTP-0.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/rewrite-declaration-imports.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint --config oxlint.config.ts src scratch lint",
    "test": "vitest run",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@effect/vitest": "4.0.0-rc.111",
    "@types/bun": "1.4.0",
    "effect-oxlint": "^0.3.3",
    "oxlint": "1.80.0",
    "oxlint-plugin-effect": "0.11.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "oxlint-tsgolint": "7.0.2001"
  },
  "foldlab": {
    "effectProvenance": {
      "commit": "0dd7825e4da4d3a00fa9bd410a1d55f3d4874d07",
      "lock": "../../.reference/provenance/sources.lock.json"
    }
  }
}
