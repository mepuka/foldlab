{
  "name": "@foldlab/plait",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Plait coordination fabric spine: canonical envelopes over NATS JetStream.",
  "bin": {
    "plait": "./src/surface/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Address": "./src/planes/Address.ts",
    "./Blob": "./src/planes/Blob.ts",
    "./Canonical": "./src/truth/Canonical.ts",
    "./Catalog": "./src/planes/Catalog.ts",
    "./Cell": "./src/planes/Cell.ts",
    "./ContextProgram": "./src/kernel/ContextProgram.ts",
    "./Digest": "./src/truth/Digest.ts",
    "./Algebra": "./src/truth/Algebra.ts",
    "./Anchor": "./src/planes/Anchor.ts",
    "./FabricClient": "./src/carriage/FabricClient.ts",
    "./Fold": "./src/planes/Fold.ts",
    "./KernelDoor": "./src/kernel/KernelDoor.ts",
    "./KernelIdentity": "./src/kernel/KernelIdentity.ts",
    "./Lane": "./src/planes/Lane.ts",
    "./Refusal": "./src/truth/Refusal.ts",
    "./Register": "./src/planes/Register.ts",
    "./Resolved": "./src/planes/Resolved.ts",
    "./Session": "./src/planes/Session.ts",
    "./Subjects": "./src/kernel/Subjects.ts",
    "./Wire": "./src/kernel/Wire.ts"
  },
  "scripts": {
    "check:address-control": "bun scripts/check-address-negative.ts",
    "check:builder-control": "bun scripts/check-kernel-builder-negative.ts",
    "check:corpus": "bun scripts/check-corpus.ts",
    "check:kernel-door": "bun scripts/check-kernel-door.ts",
    "check:kernel-door-control": "bun scripts/check-kernel-door-negative.ts",
    "check:kernel-prose": "bun scripts/check-kernel-prose.ts",
    "check:kernel-surfaces": "bun scripts/check-kernel-surfaces.ts",
    "check:kernel-surfaces-control": "bun scripts/check-kernel-surfaces.ts --self-test",
    "check:kernel-tools": "bun scripts/check-kernel-tools.ts",
    "check:kernel-tools-control": "bun scripts/check-kernel-tools-negative.ts",
    "check:layering": "bun scripts/check-layering.ts",
    "check:layering-control": "bun scripts/check-layering-negative.ts",
    "check:one-canonicalizer": "bun scripts/check-one-canonicalizer.ts",
    "check:one-canonicalizer-control": "bun scripts/check-one-canonicalizer-negative.ts",
    "check:parity-control": "bun scripts/check-substrate-parity-negative.ts",
    "check:public-effects": "bun scripts/check-public-effects.ts",
    "check:refusal-control": "bun scripts/check-refusal-vocabulary-negative.ts",
    "check:refusal-meaning-control": "bun scripts/check-refusal-meaning-negative.ts",
    "check:refusal-payloads": "bun scripts/check-refusal-payloads.ts",
    "check:refusal-vocabulary": "bun scripts/check-refusal-vocabulary.ts",
    "check:status-vocabulary": "bun scripts/check-status-vocabulary.ts",
    "check:status-vocabulary-control": "bun scripts/check-status-vocabulary.ts --self-test",
    "check:rung-control": "bun scripts/check-rung-controls.ts",
    "check:tracking-artifacts-control": "bun scripts/check-tracking-artifacts-negative.ts",
    "check:type-control": "bun scripts/check-public-effects-negative.ts",
    "check:type-universe": "bun scripts/check-public-type-universe.ts && bun scripts/check-public-type-universe.ts --enforce",
    "check:type-universe-control": "bun scripts/check-public-type-universe-negative.ts",
    "generate:builder-control": "bun scripts/check-kernel-builder-negative.ts --write",
    "generate:corpus": "bun scripts/generate-corpus.ts",
    "generate:kernel-door-control": "bun scripts/check-kernel-door-negative.ts --write",
    "generate:kernel-prose": "bun scripts/generate-kernel-prose.ts",
    "generate:layering-control": "bun scripts/check-layering-negative.ts --write",
    "generate:public-effects": "bun scripts/check-public-effects.ts --write",
    "generate:refusal-meaning-control": "bun scripts/check-refusal-meaning-negative.ts --write",
    "generate:refusal-payloads": "bun scripts/check-refusal-payloads.ts --write",
    "generate:rung-controls": "bun scripts/check-rung-controls.ts --write",
    "generate:tracking-artifacts-control": "bun scripts/check-tracking-artifacts-negative.ts --write",
    "generate:type-universe": "bun scripts/check-public-type-universe.ts --write",
    "generate:type-universe-control": "bun scripts/check-public-type-universe-negative.ts --write",
    "test": "bun run test:fast && bun run test:walls && bun run test:types",
    "test:fast": "bun scripts/run-test-group.ts fast && bun run check:corpus && bun run check:kernel-surfaces && bun run check:kernel-prose && bun run check:one-canonicalizer && bun run check:public-effects && bun run check:type-universe && bun run check:parity-control && bun run check:refusal-vocabulary && bun run check:status-vocabulary && bun run check:refusal-control && bun run check:refusal-meaning-control && bun run check:tracking-artifacts-control && bun run check:refusal-payloads && bun run check:kernel-door && bun run check:kernel-door-control && bun run check:layering && bun run check:kernel-tools",
    "test:types": "bun run check:status-vocabulary-control && bun run check:kernel-surfaces-control && bun run check:one-canonicalizer-control && bun run check:type-control && bun run check:type-universe-control && bun run check:rung-control && bun run check:builder-control && bun run check:address-control && bun run check:layering-control && bun run check:kernel-tools-control",
    "test:walls": "bun scripts/run-test-group.ts walls"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@foldlab/core": "workspace:*",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/obj": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "fast-check": "4.9.0"
  }
}
