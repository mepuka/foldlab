{
  "name": "@foldlab/plait",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Plait coordination fabric spine: canonical envelopes over NATS JetStream.",
  "bin": {
    "plait": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Canonical": "./src/Canonical.ts",
    "./Catalog": "./src/Catalog.ts",
    "./Cell": "./src/Cell.ts",
    "./ContextProgram": "./src/ContextProgram.ts",
    "./Digest": "./src/Digest.ts",
    "./Algebra": "./src/Algebra.ts",
    "./Anchor": "./src/Anchor.ts",
    "./FabricClient": "./src/FabricClient.ts",
    "./Fold": "./src/Fold.ts",
    "./Lane": "./src/Lane.ts",
    "./Refusal": "./src/Refusal.ts",
    "./Register": "./src/Register.ts",
    "./Resolved": "./src/Resolved.ts",
    "./Subjects": "./src/Subjects.ts",
    "./Wire": "./src/Wire.ts"
  },
  "scripts": {
    "check:builder-control": "bun scripts/check-kernel-builder-negative.ts",
    "check:corpus": "bun scripts/check-corpus.ts",
    "check:kernel-builder": "bun scripts/check-kernel-builder.ts",
    "check:kernel-prose": "bun scripts/check-kernel-prose.ts",
    "check:kernel-schemas": "bun scripts/check-kernel-schemas.ts",
    "check:kernel-tables": "bun scripts/check-kernel-tables.ts",
    "check:parity-control": "bun scripts/check-substrate-parity-negative.ts",
    "check:public-effects": "bun scripts/check-public-effects.ts",
    "check:type-control": "bun scripts/check-public-effects-negative.ts",
    "generate:corpus": "bun scripts/generate-corpus.ts",
    "generate:kernel-builder": "bun scripts/generate-kernel-builder.ts",
    "generate:kernel-prose": "bun scripts/generate-kernel-prose.ts",
    "generate:kernel-schemas": "bun scripts/generate-kernel-schemas.ts",
    "generate:kernel-tables": "bun scripts/generate-kernel-tables.ts",
    "generate:public-effects": "bun scripts/check-public-effects.ts --write",
    "test": "bun test ./test && bun run check:corpus && bun run check:kernel-tables && bun run check:kernel-schemas && bun run check:kernel-builder && bun run check:kernel-prose && bun run check:public-effects && bun run check:type-control && bun run check:builder-control && bun run check:parity-control"
  },
  "dependencies": {
    "@foldlab/core": "workspace:*",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/obj": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "fast-check": "4.9.0"
  }
}
