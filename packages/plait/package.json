{
  "name": "@foldlab/plait",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Plait coordination fabric spine: canonical envelopes over NATS JetStream.",
  "bin": {
    "plait": "./src/surface/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Blob": "./src/planes/Blob.ts",
    "./Canonical": "./src/truth/Canonical.ts",
    "./Catalog": "./src/planes/Catalog.ts",
    "./Cell": "./src/planes/Cell.ts",
    "./ContextProgram": "./src/kernel/ContextProgram.ts",
    "./Digest": "./src/truth/Digest.ts",
    "./Algebra": "./src/truth/Algebra.ts",
    "./Anchor": "./src/planes/Anchor.ts",
    "./FabricClient": "./src/carriage/FabricClient.ts",
    "./Fold": "./src/planes/Fold.ts",
    "./Lane": "./src/planes/Lane.ts",
    "./Refusal": "./src/truth/Refusal.ts",
    "./Register": "./src/planes/Register.ts",
    "./Resolved": "./src/planes/Resolved.ts",
    "./Session": "./src/planes/Session.ts",
    "./Subjects": "./src/kernel/Subjects.ts",
    "./Wire": "./src/kernel/Wire.ts"
  },
  "scripts": {
    "check:builder-control": "bun scripts/check-kernel-builder-negative.ts",
    "check:corpus": "bun scripts/check-corpus.ts",
    "check:expressibility": "bun scripts/check-expressibility.ts",
    "check:expressibility-control": "bun scripts/check-expressibility-negative.ts",
    "check:kernel-builder": "bun scripts/check-kernel-builder.ts",
    "check:kernel-prose": "bun scripts/check-kernel-prose.ts",
    "check:kernel-schemas": "bun scripts/check-kernel-schemas.ts",
    "check:kernel-tables": "bun scripts/check-kernel-tables.ts",
    "check:parity-control": "bun scripts/check-substrate-parity-negative.ts",
    "check:public-effects": "bun scripts/check-public-effects.ts",
    "check:type-control": "bun scripts/check-public-effects-negative.ts",
    "generate:corpus": "bun scripts/generate-corpus.ts",
    "generate:expressibility": "bun scripts/generate-expressibility.ts",
    "generate:kernel-builder": "bun scripts/generate-kernel-builder.ts",
    "generate:kernel-prose": "bun scripts/generate-kernel-prose.ts",
    "generate:kernel-schemas": "bun scripts/generate-kernel-schemas.ts",
    "generate:kernel-tables": "bun scripts/generate-kernel-tables.ts",
    "generate:public-effects": "bun scripts/check-public-effects.ts --write",
    "test": "bun run test:fast && bun run test:walls && bun run test:types",
    "test:fast": "bun scripts/run-test-group.ts fast && bun run check:corpus && bun run check:public-effects && bun run check:parity-control && bun run check:expressibility && bun run check:expressibility-control",
    "test:types": "bun run check:type-control",
    "test:walls": "bun scripts/run-test-group.ts walls"
  },
  "dependencies": {
    "@foldlab/core": "workspace:*",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/obj": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "fast-check": "4.9.0"
  }
}
