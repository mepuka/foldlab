{
  // `vendor/effect-src` holds pinned foreign bytes the extractor reads as DATA. It is
  // never imported, and typechecking someone else's source against this lane's flags
  // would report defects that are not ours to fix.
  "exclude": ["vendor"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // `bun-types`, not `bun`: the lane pins the types package directly (as the lift
    // harness does) so `tsgo --noEmit` resolves it. `"bun"` named a type library that
    // was never installed here, so the typecheck could not run at all.
    "types": ["bun-types"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // `twin/harness` is a SEPARATE package with its own package.json, lockfile and
  // node_modules (it pins `effect` and is installed only when the twin gate runs).
  // Without this bound the lane's typecheck pulled it into one program and failed on
  // dependencies that were never meant to be resolvable from here.
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
